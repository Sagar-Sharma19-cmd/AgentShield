# ============================================================
# AgentShield — Environment Variables Example
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=agentshield
POSTGRES_USER=agentshield_user
POSTGRES_PASSWORD=changeme

# --- Backend (Spring Boot) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/agentshield
SPRING_DATASOURCE_USERNAME=agentshield_user
SPRING_DATASOURCE_PASSWORD=changeme
RISK_ENGINE_URL=http://localhost:8000

# --- Backend security (REQUIRED, >= 32 characters each) ---
# Generate each with: openssl rand -base64 48
# The pepper must stay stable: changing it invalidates every agent API key.
AGENTSHIELD_API_KEY_PEPPER=replace-with-output-of-openssl-rand-base64-48
AGENTSHIELD_ADMIN_API_KEY=replace-with-output-of-openssl-rand-base64-48

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
