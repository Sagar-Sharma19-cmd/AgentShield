# Copy to .env.local. Server-side only: next.config.ts proxies /api/v1/* to this URL,
# so the browser never talks to the backend directly and no CORS setup is needed.
# Defaults to http://localhost:8081 if unset.
BACKEND_URL=http://localhost:8081

# Label for the environment badge in the console sidebar footer (for example "Staging" or "Demo").
# Public: NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so never put a secret here.
# Defaults to "Local" if unset.
NEXT_PUBLIC_AGENTSHIELD_ENV=Local
