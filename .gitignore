# ============================================================
# AgentShield — .gitignore
# Covers: Java/Maven, Node/Next.js, Python, Docker, OS files
# ============================================================

# ----------------------------
# Environment / Secrets
# ----------------------------
.env
.env.*
!.env.example
*.secret
secrets/

# ----------------------------
# Java / Maven
# ----------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*

# Maven wrapper
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.launch
.factorypath

# ----------------------------
# Node.js / Next.js
# ----------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
.env/
ENV/

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# Pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# Jupyter
.ipynb_checkpoints/

# ----------------------------
# Docker
# ----------------------------
# (docker-compose.yml itself is committed; ignore local overrides)
docker-compose.override.yml

# ----------------------------
# macOS
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# ----------------------------
# Linux
# ----------------------------
*~

# ----------------------------
# Windows
# ----------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------
# Logs
# ----------------------------
logs/
*.log
log/

# ----------------------------
# Test output
# ----------------------------
test-results/
surefire-reports/
